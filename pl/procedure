-- Create a procedure to get all branches by city using a cursor
CREATE OR REPLACE PROCEDURE get_branches_by_city (
    p_city IN VARCHAR2
) IS
    CURSOR branch_cursor IS
        SELECT BRANCH_ID, BRANCH_NAME, BRANCH_DOOR_NUMBER, BRANCH_STREET, BRANCH_PINCODE
        FROM BRANCH
        WHERE BRANCH_CITY = p_city;
BEGIN
    FOR branch_record IN branch_cursor LOOP
        DBMS_OUTPUT.PUT_LINE('BRANCH_ID: ' || branch_record.BRANCH_ID);
        DBMS_OUTPUT.PUT_LINE('BRANCH_NAME: ' || branch_record.BRANCH_NAME);
        DBMS_OUTPUT.PUT_LINE('BRANCH_DOOR_NUMBER: ' || branch_record.BRANCH_DOOR_NUMBER);
        DBMS_OUTPUT.PUT_LINE('BRANCH_STREET: ' || branch_record.BRANCH_STREET);
        DBMS_OUTPUT.PUT_LINE('BRANCH_PINCODE: ' || branch_record.BRANCH_PINCODE);
        DBMS_OUTPUT.PUT_LINE('-----------------------------------');
    END LOOP;
END get_branches_by_city;

-- Execute the get_branches_by_city procedure for a specific city
BEGIN
    get_branches_by_city('SIVAKASI');
END;
