-- Create a procedure with a ref cursor to retrieve all supplier records
CREATE OR REPLACE PROCEDURE supplier_with_ref_cursor (
    p_cursor OUT SYS_REFCURSOR
) IS
BEGIN
    OPEN p_cursor FOR
    SELECT * FROM SUPPLIER;
END supplier_with_ref_cursor;

-- Declare a ref cursor and fetch records using the supplier_with_ref_cursor procedure
DECLARE
    v_cursor SYS_REFCURSOR;
    v_sup_id NUMBER;
    v_sup_name VARCHAR2(15);
    v_sup_doorno VARCHAR2(20);
    v_sup_street VARCHAR2(20);
    v_sup_city VARCHAR2(15);
    v_sup_pincode VARCHAR2(8);
    v_regular CHAR(1);
    v_seasonal CHAR(1);
BEGIN
    supplier_with_ref_cursor(v_cursor);
    LOOP
        FETCH v_cursor INTO v_sup_id, v_sup_name, v_sup_doorno, v_sup_street, v_sup_city, v_sup_pincode, v_regular, v_seasonal;
        EXIT WHEN v_cursor%NOTFOUND;
        DBMS_OUTPUT.PUT_LINE('SUP_ID: ' || v_sup_id || ', SUP_NAME: ' || v_sup_name || ', SUP_DOORNO: ' || v_sup_doorno || ', SUP_STREET: ' || v_sup_street || ', SUP_CITY: ' || v_sup_city || ', SUP_PINCODE: ' || v_sup_pincode || ', REGULAR: ' || v_regular || ', SEASONAL: ' || v_seasonal);
    END LOOP;
    CLOSE v_cursor;
END;

-- Create a procedure with exception handling for inserting a supplier record
CREATE OR REPLACE PROCEDURE supplier_with_exception_handling (
    p_sup_id IN NUMBER,
    p_sup_name IN VARCHAR2,
    p_sup_doorno IN VARCHAR2,
    p_sup_street IN VARCHAR2,
    p_sup_city IN VARCHAR2,
    p_sup_pincode IN VARCHAR2,
    p_regular IN CHAR,
    p_seasonal IN CHAR
) IS
BEGIN
    INSERT INTO SUPPLIER (SUP_ID, SUP_NAME, SUP_DOORNO, SUP_STREET, SUP_CITY, SUP_PINCODE, REGULAR, SEASONAL)
    VALUES (p_sup_id, p_sup_name, p_sup_doorno, p_sup_street, p_sup_city, p_sup_pincode, p_regular, p_seasonal);
    COMMIT;
