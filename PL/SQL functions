### Procedure to Get All Suppliers in a City
This procedure retrieves and prints the details of all suppliers in a given city.
```sql
CREATE OR REPLACE PROCEDURE get_suppliers_in_city (p_city IN VARCHAR2)
IS
    CURSOR cur_suppliers IS
        SELECT SUP_ID, SUP_NAME, SUP_DOORNO, SUP_STREET, SUP_CITY, SUP_PINCODE, REGULAR, SEASONAL
        FROM supplier
        WHERE SUP_CITY = p_city;
    v_supplier cur_suppliers%ROWTYPE;
BEGIN
    OPEN cur_suppliers;
    LOOP
        FETCH cur_suppliers INTO v_supplier;
        EXIT WHEN cur_suppliers%NOTFOUND;

        DBMS_OUTPUT.PUT_LINE('Supplier ID: ' || v_supplier.SUP_ID);
        DBMS_OUTPUT.PUT_LINE('Name: ' || v_supplier.SUP_NAME);
        DBMS_OUTPUT.PUT_LINE('Door No: ' || v_supplier.SUP_DOORNO);
        DBMS_OUTPUT.PUT_LINE('Street: ' || v_supplier.SUP_STREET);
        DBMS_OUTPUT.PUT_LINE('City: ' || v_supplier.SUP_CITY);
        DBMS_OUTPUT.PUT_LINE('Pincode: ' || v_supplier.SUP_PINCODE);
        DBMS_OUTPUT.PUT_LINE('Regular: ' || v_supplier.REGULAR);
        DBMS_OUTPUT.PUT_LINE('Seasonal: ' || v_supplier.SEASONAL);
        DBMS_OUTPUT.PUT_LINE('----------------------');
    END LOOP;
    CLOSE cur_suppliers;
EXCEPTION
    WHEN OTHERS THEN
        DBMS_OUTPUT.PUT_LINE('Error: ' || SQLERRM);
END get_suppliers_in_city;
/
```

