def find_min_groups(n, parents):
    # Create an adjacency list representation of the forest
    tree = [[] for _ in range(n + 1)]
    roots = []

    for i in range(1, n + 1):
        p = parents[i - 1]
        if p == -1:
            roots.append(i)  # Identify root nodes
        else:
            tree[p].append(i)  # Add child to parent in adjacency list

    # Function to calculate the height of a tree using DFS
    def calculate_height(node):
        height = 0
        for child in tree[node]:
            height = max(height, calculate_height(child))
        return height + 1

    # Find the maximum height among all trees
    max_height = 0
    for root in roots:
        max_height = max(max_height, calculate_height(root))

    return max_height

