def get_max_score(n):
    if n <= 2:
        return n - 1
    
    # dp[i] represents the maximum score possible for a stack of size i
    dp = [0] * (n + 1)
    dp[2] = 1
    
    # Fill dp table for all sizes from 3 to n
    for size in range(3, n + 1):
        # For larger numbers, we can optimize by considering
        # splits near the middle, as they tend to give better results
        left = size // 3
        right = (size + 1) // 2
        
        max_score = 0
        for split in range(left, right + 1):
            # When we split size into split and (size-split):
            current_score = (split * (size - split) + 
                           dp[split] + 
                           dp[size - split])
            max_score = max(max_score, current_score)
        dp[size] = max_score
    
    return dp[n]

def main():
