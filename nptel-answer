        new_curr_cards = curr_player_cards.copy()
        new_curr_cards.remove(card)
        
        # If opponent can't win after this move, current player wins
        if not can_win(other_player_cards, new_curr_cards, card, memo):
            memo[state] = True
            return True
    
    # If no winning move was found, current player loses
    memo[state] = False
    return False

