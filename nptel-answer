def can_achieve_shortest_path_length(n, m, L, s, t, edges):
    """
    Determine if it's possible to assign weights to erased edges to achieve a shortest path of length L
    
    Args:
        n: Number of vertices
        m: Number of edges
        L: Desired shortest path length
        s: Starting vertex
        t: Ending vertex
        edges: List of edges (u, v, w) where w=0 means weight is erased
        
    Returns:
        Boolean indicating if the desired shortest path length can be achieved
    """
    # Identify edges with known weights and edges with erased weights
    known_edges = []
    erased_edges = []
    
    # Store edges in appropriate lists
    for u, v, w in edges:
        if w > 0:
            known_edges.append((u, v, w))
        else:
            erased_edges.append((u, v))
    
    # Build adjacency list for the graph
    graph = [[] for _ in range(n)]
    for u, v, w in known_edges:
        graph[u].append((v, w))
        graph[v].append((u, w))
    
    # Run Dijkstra's algorithm to find shortest path using only known edge weights
    import heapq
    distance = [float('inf')] * n
    distance[s] = 0
    priority_queue = [(0, s)]
    visited = [False] * n
    
    while priority_queue:
        dist, node = heapq.heappop(priority_queue)
        
        if visited[node]:
            continue
        
        visited[node] = True
        
        if node == t:
            break
            
        for neighbor, weight in graph[node]:
            if not visited[neighbor] and distance[node] + weight < distance[neighbor]:
                distance[neighbor] = distance[node] + weight
                heapq.heappush(priority_queue, (distance[neighbor], neighbor))
    
    # If shortest path is already <= L using only known edges, we can't increase it
    if distance[t] <= L:
        # If equal to L, we're done
        if distance[t] == L:
            return True
        # If less than L, we can't make it longer without changing known weights
        return False
    
    # If t is unreachable with just known edges, we need to check if we can create a path
    # with erased edges that has total length L
    
    # Build a new graph that includes all edges (known and erased)
    full_graph = [[] for _ in range(n)]
    for u, v, w in known_edges:
        full_graph[u].append((v, w))
        full_graph[v].append((u, w))
    
    for u, v in erased_edges:
        # Add erased edges with weight 1 (minimum possible weight)
        full_graph[u].append((v, 1))
        full_graph[v].append((u, 1))
    
    # Run BFS to find the shortest path in terms of number of edges
    from collections import deque
    
    # Stores (node, distance, edges_used)
    queue = deque([(s, 0, 0)])
    visited = [False] * n
    
    # Track shortest path in terms of edges count
    min_edges_path = None
    
    while queue:
        node, dist, edges_used = queue.popleft()
        
        if visited[node]:
            continue
            
        visited[node] = True
        
        if node == t:
            min_edges_path = (dist, edges_used)
            break
            
        for neighbor, weight in full_graph[node]:
            if not visited[neighbor]:
                if weight == 1:  # This is an erased edge
                    queue.append((neighbor, dist + 1, edges_used + 1))
                else:
                    queue.append((neighbor, dist + weight, edges_used))
    
    # If t is still unreachable even with erased edges, return False
    if min_edges_path is None:
        return False
    
    # min_edges_path[0] is the current shortest path with all erased edges having weight 1
    # If this is already > L, we can't make it shorter
    if min_edges_path[0] > L:
        return False
        
    # We can assign weights to erased edges to make the shortest path exactly L
    # This is possible if L - (current_min_distance) <= 10^9 * (number of erased edges used in path)
    # Since we can make any erased edge up to 10^9
    path_dist, used_erased_edges = min_edges_path
    remaining_length = L - path_dist
    
    # We can add remaining_length to erased edges used in the path
    return remaining_length >= 0

