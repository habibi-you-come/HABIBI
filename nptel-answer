def find_min_distance(grid, n, m):
    # Create a list of all empty seats
    empty_seats = [(i, j) for i in range(n) for j in range(m) if grid[i][j] == 0]
    
    # If there are less than 2 empty seats, return -1
    if len(empty_seats) < 2:
        return -1

    # Sort the empty seats to minimize iteration
    empty_seats.sort()

    # Initialize the minimum distance to infinity
    min_distance = float('inf')

    # Iterate over all pairs of empty seats
    for i in range(len(empty_seats)):
        for j in range(i + 1, len(empty_seats)):
            x1, y1 = empty_seats[i]
            x2, y2 = empty_seats[j]
            # Calculate Manhattan distance
            distance = abs(x1 - x2) + abs(y1 - y2)
            # Update minimum distance
            min_distance = min(min_distance, distance)

            # Break early if the distance becomes 1 (minimum possible)
            if min_distance == 1:
