MOD = 10**9 + 7

def find_paths(grid, n, m):
    # Create a DP table
    dp = [[0] * m for _ in range(n)]
    
    # Base case: Starting point
    dp[0][0] = 1
    
    # Fill the DP table
    for i in range(n):
        for j in range(m):
            if grid[i][j] == -1:  # Cell is a dead-end
                dp[i][j] = 0
            else:
                if i > 0:  # Add paths from the top cell
                    dp[i][j] += dp[i-1][j]
                if j > 0:  # Add paths from the left cell
                    dp[i][j] += dp[i][j-1]
                dp[i][j] %= MOD  # Take modulo at each step to prevent overflow
    
    return dp[n-1][m-1]  # Return the number of ways to reach the bottom-right corner

def main():
    T = int(input())  # Number of test cases
    results = []
    for _ in range(T):
        # Read grid dimensions
