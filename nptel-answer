def max_pieces(n, a, b, c):
    # Create a DP array to store the maximum pieces for each length
    dp = [-1] * (n + 1)
    dp[0] = 0  # Base case: 0 length stick can be split into 0 pieces

    # Iterate through each possible stick length
    for i in range(1, n + 1):
        if i >= a and dp[i - a] != -1:
            dp[i] = max(dp[i], dp[i - a] + 1)
        if i >= b and dp[i - b] != -1:
            dp[i] = max(dp[i], dp[i - b] + 1)
        if i >= c and dp[i - c] != -1:
            dp[i] = max(dp[i], dp[i - c] + 1)

    return dp[n]

def main():
