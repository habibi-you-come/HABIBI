def bipartite_matching(graph, n):
    """Find the maximum bipartite matching in the graph."""
    match = [-1] * (n + 1)
    visited = [False] * (n + 1)

    def bpm(u):
        for v in graph[u]:
            if not visited[v]:
                visited[v] = True
                if match[v] == -1 or bpm(match[v]):
                    match[v] = u
                    return True
        return False

    # Count the maximum matching
