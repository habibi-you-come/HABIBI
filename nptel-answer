    # We'll use a list to keep track of colors in the row
    row = []
    
    # Process each query
    for query in queries:
        if query[0] == 1:
            # Type 1: Add a cube with color X to the end
            color = query[1]
            row.append(color)
        
        elif query[0] == 2:
            # Type 2: Repaint all cubes of color X to color Y
            color_from = query[1]
            color_to = query[2]
            
            # Update all instances of color_from to color_to
            for i in range(len(row)):
                if row[i] == color_from:
                    row[i] = color_to
    
    return row

def solve_cube_painting_offline(queries):
    # For offline approach, we need to identify the final color of each position
    
    # First, identify positions where cubes are added
    positions = []
    for query in queries:
        if query[0] == 1:
            positions.append(query[1])  # Original color
    
    # Now, trace the color transformations by applying all Type 2 queries
    # Start with original colors and apply transformations in order
    final_colors = positions.copy()
    
    for query in queries:
        if query[0] == 2:
