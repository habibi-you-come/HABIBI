class UnionFind:
    def __init__(self, n):
        self.parent = list(range(n))
        self.rank = [0] * n

    def find(self, x):
        if self.parent[x] != x:
            self.parent[x] = self.find(self.parent[x])  # Path compression
        return self.parent[x]

    def union(self, x, y):
        rootX = self.find(x)
        rootY = self.find(y)
        
        if rootX != rootY:
            # Union by rank
            if self.rank[rootX] > self.rank[rootY]:
                self.parent[rootY] = rootX
            elif self.rank[rootX] < self.rank[rootY]:
                self.parent[rootX] = rootY
            else:
                self.parent[rootY] = rootX
                self.rank[rootX] += 1
            return True
        return False

def kruskal(n, edges):
    # Sort edges by weight
    edges.sort(key=lambda x: x[2])  # x[2] is the weight of the edge
    
    uf = UnionFind(n)
    mst_weight = 0
    mst_edges = 0
    
    for u, v, weight in edges:
        if uf.union(u-1, v-1):  # Union the cities (nodes)
            mst_weight += weight
            mst_edges += 1
            if mst_edges == n - 1:  # We have added n-1 edges, tree is complete
                break
    
    return mst_weight

def solve():
    t = int(input())  # Number of test cases
    for _ in range(t):
        n, m = map(int, input().split())  # n nodes, m edges
        edges = []
        for _ in range(m):
            u, v, w = map(int, input().split())
            edges.append((u, v, w))
        
        # Get the minimum spanning tree's total weight
        result = kruskal(n, edges)
        print(result)

