def solve_test_case():
    # Read N and Q
    N, Q = map(int, input().split())
    
    # Read the number of Maggi packets in each box
    boxes = list(map(int, input().split()))
    
    # Sort boxes in descending order for greedy approach
    boxes.sort(reverse=True)
    
    # Precompute prefix sums for faster query processing
    prefix_sums = [0] * (N + 1)
    for i in range(N):
        prefix_sums[i + 1] = prefix_sums[i] + boxes[i]
    
    # Process each query
    for _ in range(Q):
        target = int(input())
        
        # If target is greater than total sum, it's impossible
        if target > prefix_sums[N]:
            print(-1)
            continue
        
        # Binary search to find minimum number of boxes needed
        left, right = 1, N
        result = -1
        
        while left <= right:
            mid = (left + right) // 2
            if prefix_sums[mid] >= target:
                result = mid
                right = mid - 1
            else:
                left = mid + 1
        
        print(result)

