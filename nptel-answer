def find_cycle_sizes(n, permutation):
    # Create an array to store the size of the cycle for each element
    cycle_sizes = [0] * n
    visited = [False] * n
    
    for i in range(n):
        if not visited[i]:
            # Start a new cycle
            cycle_length = 0
            current = i
            
            # Trace the cycle
            while not visited[current]:
                visited[current] = True
                cycle_length += 1
                current = permutation[current] - 1  # Move to the next element in the cycle
            
            # Assign the cycle length to all elements in the cycle
            current = i
            while True:
                cycle_sizes[current] = cycle_length
                current = permutation[current] - 1
                if current == i:
                    break
    
    return cycle_sizes

